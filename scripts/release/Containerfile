FROM docker.io/library/ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential clang lld cmake ninja-build pkg-config git ca-certificates python3 \
    glslang-tools zstd binutils rustup libsdl2-dev libfreetype-dev libasound2-dev \
    libdbus-1-dev libgl1-mesa-dev libpulse-dev libudev-dev libwayland-dev libx11-dev \
    libxcursor-dev libxext-dev libxfixes-dev libxi-dev libxkbcommon-dev libxrandr-dev \
    libxss-dev libxtst-dev wayland-protocols \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
# Ubuntu ships rustup in /usr/bin; it refuses to run unless it also sits in $CARGO_HOME/bin
RUN mkdir -p /opt/cargo/bin && ln -s /usr/bin/rustup /opt/cargo/bin/rustup \
    && rustup toolchain install 1.100.0 --profile minimal && rustup default 1.100.0
RUN chmod -R a+rX /opt/rustup /opt/cargo
